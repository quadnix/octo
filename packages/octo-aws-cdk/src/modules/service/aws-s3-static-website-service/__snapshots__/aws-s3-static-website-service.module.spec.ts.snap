  provider = aws._123-us-east-1
  bucket = aws_s3_bucket.bucket-test-bucket_website_bucket.id
  policy = jsonencode({
    Statement = [{
        Action = ["s3:GetObject"]
        Effect = "Allow"
        Principal = "*"
        Resource = ["\${aws_s3_bucket.bucket-test-bucket_website_bucket.arn}/*"]
        Sid = "PublicReadGetObject"
      }]
    Version = "2012-10-17"
  })

