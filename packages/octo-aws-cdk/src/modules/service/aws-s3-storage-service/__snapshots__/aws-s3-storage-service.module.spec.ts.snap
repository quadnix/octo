  etag = filemd5("\${var.OCTO_PROJECT_ROOT}/resources/s3-static-website/page-1.html")
  key = "page-1.html"
  source = "\${var.OCTO_PROJECT_ROOT}/resources/s3-static-website/page-1.html"
}

- service/main.tf
