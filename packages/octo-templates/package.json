{
  "dependencies": {
    "@aws-sdk/client-cloudfront": "~3.743.0",
    "@aws-sdk/client-dynamodb": "~3.743.0",
    "@aws-sdk/client-ec2": "~3.743.0",
    "@aws-sdk/client-ecr": "~3.743.0",
    "@aws-sdk/client-ecs": "~3.743.0",
    "@aws-sdk/client-iam": "~3.743.0",
    "@aws-sdk/client-resource-groups-tagging-api": "~3.743.0",
    "@aws-sdk/lib-dynamodb": "~3.743.0",
    "@quadnix/octo": "~0.2.0",
    "@quadnix/octo-aws-cdk": "~0.2.1",
    "@quadnix/octo-event-listeners": "~0.2.0",
    "env-smart": "~2.3.2",
    "js-yaml": "~4.1.0"
  },
  "description": "Octo-Templates are examples of end-to-end infrastructures.",
  "devDependencies": {
    "@quadnix/octo-build": "~0.2.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "jest": {
    "coverageDirectory": "./coverage",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "(.+)\\.js": "$1"
    },
    "passWithNoTests": true,
    "preset": "ts-jest/presets/default-esm",
    "rootDir": ".",
    "setupFilesAfterEnv": [
      "<rootDir>/src/utilities/redaction/redaction.setup.ts"
    ],
    "testEnvironment": "node",
    "testRegex": ".*spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "name": "@quadnix/octo-templates",
  "nx": {
    "tags": [
      "scope:octo-templates"
    ]
  },
  "private": true,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "check:circular-dependency": "dpdm --no-tree --exit-code circular:1 --no-warning ./dist/**/*.js",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --testRegex=\"\\.spec.ts$\"",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --testRegex=\"\\.spec.ts$\"",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --testRegex=\"\\.e2e-spec.ts$\"",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testRegex=\"\\.ispec.ts$\" --runInBand",
    "test:secrets": "NODE_OPTIONS=--experimental-vm-modules jest --testRegex=\"repository-secrets\\.spec.ts$\"",
    "test:watch": "jest --watch"
  },
  "type": "module",
  "version": "0.2.0"
}
