{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "env": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "enum": ["boolean", "number", "string"],
            "type": "string"
          },
          "value": {}
        },
        "required": ["key", "kind", "value"],
        "type": "object"
      },
      "type": "array"
    },
    "hooks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "importPath": {
            "type": "string"
          },
          "method": {
            "type": "string"
          }
        },
        "required": ["importPath", "method"],
        "type": "object"
      },
      "type": "array"
    },
    "imports": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "className": {
            "type": "string"
          },
          "importPath": {
            "type": "string"
          }
        },
        "required": ["className", "importPath"],
        "type": "object"
      },
      "type": "array"
    },
    "modules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "moduleClass": {
            "type": "string"
          },
          "moduleId": {
            "type": "string"
          },
          "moduleInputs": {
            "type": "object"
          }
        },
        "required": ["moduleClass", "moduleId", "moduleInputs"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "settings": {
      "additionalProperties": false,
      "properties": {
        "listeners": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "JournalEventListener",
                    "type": "string"
                  }
                },
                "required": ["type"],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "colorize": {
                    "type": "boolean"
                  },
                  "level": {
                    "enum": ["debug", "error", "fatal", "info", "silent", "trace", "warn"],
                    "type": "string"
                  },
                  "type": {
                    "const": "LoggingEventListener",
                    "type": "string"
                  }
                },
                "required": ["type"],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "stateProvider": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "encryptionKey": {
                  "type": "string"
                },
                "statePath": {
                  "type": "string"
                },
                "type": {
                  "const": "LocalEncryptionStateProvider",
                  "type": "string"
                }
              },
              "required": ["encryptionKey", "type", "statePath"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "statePath": {
                  "type": "string"
                },
                "type": {
                  "const": "LocalStateProvider",
                  "type": "string"
                }
              },
              "required": ["type", "statePath"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "appId": {
                  "type": "string"
                },
                "checkInIntervalInSeconds": {
                  "maximum": 60,
                  "minimum": 5,
                  "type": "integer"
                },
                "lockContext": {
                  "type": "string"
                },
                "organizationId": {
                  "type": "string"
                },
                "sessionId": {
                  "type": "string"
                },
                "stateManagementServiceUrl": {
                  "type": "string"
                },
                "statePath": {
                  "type": "string"
                },
                "type": {
                  "const": "RemoteStateProvider",
                  "type": "string"
                }
              },
              "required": ["appId", "organizationId", "sessionId", "stateManagementServiceUrl", "statePath", "type"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "TestStateProvider",
                  "type": "string"
                }
              },
              "required": ["type"],
              "type": "object"
            }
          ]
        }
      },
      "required": ["stateProvider"],
      "type": "object"
    },
    "tags": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "scope": {
            "additionalProperties": false,
            "properties": {
              "moduleId": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": ["tags"],
        "type": "object"
      },
      "type": "array"
    },
    "terraform": {
      "additionalProperties": false,
      "properties": {
        "providers": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "accountId": {
                "type": "string"
              },
              "accountName": {
                "type": "string"
              },
              "providerType": {
                "type": "string"
              },
              "regionId": {
                "type": "string"
              },
              "setRegionAttribute": {
                "type": "boolean"
              },
              "spec": {
                "type": "object"
              }
            },
            "required": ["accountId", "providerType", "regionId"],
            "type": "object"
          },
          "type": "array"
        },
        "requiredProviders": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "minVersion": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": ["source"],
            "type": "object"
          },
          "type": "object"
        },
        "requiredVersion": {
          "type": "string"
        }
      },
      "required": ["providers", "requiredProviders", "requiredVersion"],
      "type": "object"
    },
    "version": {
      "enum": [1],
      "type": "number"
    }
  },
  "required": ["imports", "modules", "settings", "terraform", "version"],
  "title": "Octo V1 Definition Schema",
  "type": "object"
}
