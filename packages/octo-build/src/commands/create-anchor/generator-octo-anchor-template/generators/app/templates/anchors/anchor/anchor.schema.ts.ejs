<% if (isModelAnchor) { -%>
<%# Sorted here rather than written in a fixed order: the model type is the only variable member,
    and where it falls among the others depends on its name - `Region` sorts before `Schema`,
    `Service` after it. A fixed order fails the generated app's own import/order and sort-imports
    rules for half the model types. -%>
<% const anchorSchemaImports = ['BaseAnchorSchema', 'Schema', 'Validate', modelTypePascal]
     .sort()
     .map((member) => (member === modelTypePascal ? `type ${member}` : member))
     .join(', '); -%>
import { <%= anchorSchemaImports %> } from '@quadnix/octo';
<% } else { -%>
import { type AOverlay, BaseAnchorSchema, type BaseOverlaySchema, Schema, Validate } from '@quadnix/octo';
<% } -%>

export class <%= anchorNamePascal %>AnchorSchema extends BaseAnchorSchema {
  <% if (isModelAnchor) { -%>
parentInstance: <%- modelTypePascal %>;
  <% } else { -%>
parentInstance: AOverlay<BaseOverlaySchema, any>;
  <% } -%>

  @Validate({
    destruct: (value: <%= anchorNamePascal %>AnchorSchema['properties']): string[] => [
      // Fix me: Add properties for validation.
    ],
    options: { minLength: 1 },
  })
  override properties = Schema<{
    // Fix me: Add anchor properties.
  }>();
}
